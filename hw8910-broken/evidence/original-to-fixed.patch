+def rows(path):
+    return [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
+
+
+def hashes(root, names):
+    return {name: file_digest(root/name) for name in sorted(names)}
+
+
+def main():
+    import mlflow
+    import torch
+    import yaml
+    from mlflow import MlflowClient
